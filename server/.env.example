# ========================================================
# AI Error Message Helper - Server Configuration Example
# ========================================================

# The port where this Express API server will listen
PORT=5004

# Your Google Gemini API Key
# 1. Visit Google AI Studio: https://aistudio.google.com/app/apikey
# 2. Click "Create API Key"
# 3. Paste the generated key below (replace the placeholder)
GEMINI_API_KEY=your_gemini_api_key_here

# The Gemini model name to use for analysis
# Lowest cost / Economical model: gemini-3.5-flash-lite (recommended)
# Alternatives: gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Allowed Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:3000
